# =================================================================
# 知识助手 .env 模板
# 复制到 ~/.hermes/profiles/knowledge/.env 后填真值
# =================================================================

# === AI Provider ===
# DeepSeek (主力，OpenAI 兼容 API)
# 申请: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Hermes 行为 ===
# 单次 agent 调用最大 tool-calling 轮次（默认 90，长视频 pipeline 需要 ≥150）
HERMES_MAX_ITERATIONS=180

# === 飞书 Bot ===
# 申请: https://open.feishu.cn/ 建一个自建应用，开启机器人能力 + 消息卡片权限
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket

# 白名单（限制只有这些用户能跟 bot 对话，安全考虑）
# 你的 open_id 第一次发消息后能在 logs/agent.log 看到
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 群聊策略：closed = 不响应群聊，open = 群聊也响应
FEISHU_GROUP_POLICY=closed
